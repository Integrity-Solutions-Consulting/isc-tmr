# ------- Better Auth (isc-tmr como relying party, modo stateless) -------
# Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL con la que el NAVEGADOR llega a isc-tmr (no la del servidor). Si se abre
# desde otra máquina de la LAN, usar la IP con HTTPS: https://192.168.100.227:4200
# (y añadir esa IP a `allowedDevOrigins` en next.config.ts para `next dev`).
# El gate (OAuth 2.1) exige https fuera de localhost: `bun run dev:https` levanta
# HTTPS con el certificado de ~/.local/share/isc-dev-certs.
BETTER_AUTH_URL=http://localhost:4200

# ------- ISC Auth Gate (OIDC) -------
# URL con la que el NAVEGADOR llega al gate, incluido su basePath. Debe
# coincidir EXACTAMENTE con el `issuer` de
# ${OIDC_ISSUER}/.well-known/openid-configuration (se valida en el id_token y en
# los access tokens). Escenario LAN: https://192.168.100.227:3000/api/auth
OIDC_ISSUER=http://localhost:3000/api/auth
# Cliente confidencial creado en el gate (/dashboard/administration/oauth)
# Redirect URI a registrar: ${BETTER_AUTH_URL}/api/auth/callback/isc-gate
#   ej. http://localhost:4200/api/auth/callback/isc-gate
#   ej. LAN: https://192.168.100.227:4200/api/auth/callback/isc-gate
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Identifier del Resource registrado en el gate (aud del access token). Es solo
# un identificador: no tiene que ser accesible, no hace falta cambiarlo en la LAN
OIDC_RESOURCE=http://localhost:4200/api
