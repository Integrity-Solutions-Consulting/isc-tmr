{
  "name": "isc-tmr",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun --bun --env-file=.env.local --env-file=.env.localhost --inspect=1001 next dev -p 4200",
    "dev:https": "bun --bun --inspect=1001 next dev -p 4200 --experimental-https --experimental-https-key $HOME/.local/share/isc-dev-certs/dev-key.pem --experimental-https-cert $HOME/.local/share/isc-dev-certs/dev.pem --experimental-https-ca $HOME/.local/share/isc-dev-certs/rootCA.pem",
    "build": "bun --bun next build",
    "start": "bun --bun next start"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@better-auth/oauth-provider": "1.7.1",
    "@elysia/eden": "^1.4.10",
    "@elysia/openapi": "^1.4.16",
    "@remixicon/react": "^4.9.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "better-auth": "1.7.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "elysia": "^1.4.30",
    "elysia-healthcheck": "^1.0.0",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "next-intl": "^4.14.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.1",
    "swr": "^2.5.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.4.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.4.2",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
